# ── Skin artwork. Leave empty: cards show an explicit "artwork not enabled" plate.
# Set to "ddragon" to hot-link Riot's Data Dragon splash art (ids come from the
# catalogue snapshot). Clear the asset terms first: Riot's developer policy for
# Data Dragon requires product registration and says "No cryptocurrencies, no
# blockchain"; the fan-content policy excludes commercial projects.
NEXT_PUBLIC_SKIN_ART=

# ── Chain and token (no default: nothing is assumed)
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_CHAIN_RPC_URL=
NEXT_PUBLIC_CHAIN_EXPLORER_URL=
NEXT_PUBLIC_TOKEN_ADDRESS=

# ── Sessions (required in production; dev generates its own key in ./data)
# 32+ random characters. Signs the wallet session cookie.
SESSION_SECRET=

# ── Operator panel (/admin). 16+ characters. Without it the panel is off, and
# no reward or code can be entered.
ADMIN_SECRET=

# ── Claims (required in production). 32+ random characters. Encrypts RP codes
# at rest. Losing it makes stored codes unreadable; never rotate it casually.
CLAIM_SECRET=

# ── Storage (optional). Directory for the SQLite database. Defaults to ./data.
# Must be a persistent disk in production: claims are refused on ephemeral storage.
SKINFUND_DATA_DIR=
